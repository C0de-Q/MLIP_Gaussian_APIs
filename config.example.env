# ============================================================
# MLIP_Gau_APIs configuration template
#
# How to use:
#   1. Copy this file to config.env (config.env is git-ignored and stays local)
#   2. Fill in your own absolute paths
#   3. Both the Python side (constants.py) and RunMLIPgjf.sh read config.env from
#      the repository root automatically
#
# You can skip the file and export the same variables in your shell instead;
# environment variables take precedence.
# ============================================================

# ---- Model weights: full paths including the file name, no directory search ----
# Fill in only the models you use; a missing entry produces a clear error when
# that model is requested.
# Example: MLIP_MODEL_MACE_POLAR=/data/models/MACE-POLAR-1-M.model
MLIP_MODEL_MACE_POLAR=
MLIP_MODEL_MACE_OMOL=
MLIP_MODEL_MACE_OFF23=
MLIP_MODEL_MACE_OFF24=
MLIP_MODEL_DPA3_OMOL=
MLIP_MODEL_DPA2_DRUG=
MLIP_MODEL_DPA4=

# ---- External programs: absolute paths, or make sure they are on PATH ----
MLIP_XTB_BIN=xtb
MLIP_AITOMIC_BIN=aitomic
MLIP_MLATOM_BIN=mlatom

# ---- Device ----
# One device for every model the server evaluates: the declarative ASE
# calculators and the cached functional ones (mace_polar, orbmol_v2, ...).
# Defaults to cuda when a GPU is available and cpu otherwise; accepts what
# torch.device accepts (cpu, cuda, cuda:0, ...). Uncomment to pin it.
MLIP_SERVER_DEVICE=cuda:0

# ---- MLIP server (persistent inference, started by RunMLIPgjf.sh) ----
MLIP_SERVER_PORT=15556
MLIP_SERVER_HOST=127.0.0.1
METHOD=mace_off24

# ---- Python environment for the server, and Gaussian (used by the shell script) ----
# Interpreter that starts the server (default python3)
# MLIP_PYTHON=/path/to/conda/envs/mace/bin/python
# Or a shell snippet that activates the environment (use one of the two):
# MLIP_CONDA_SETUP="source /path/miniconda3/etc/profile.d/conda.sh && conda activate mace"

